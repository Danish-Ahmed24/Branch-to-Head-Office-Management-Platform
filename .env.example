# Development only. Never use these example credentials in production.
# Backend reads exported variables; source this file explicitly after copying.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/shiplens
CORS_ORIGINS='["http://localhost:5173"]'
# Optional in production: absolute location of npm build output.
# STATIC_DIR=/app/frontend/dist
APP_ENV=development
PORT=8000
# For backend integration tests (use a separate DB once tests write domain data):
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/shiplens
# Optional Vite development override (default shown):
# API_PROXY_TARGET=http://127.0.0.1:8000
